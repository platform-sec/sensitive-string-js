# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
*.tsbuildinfo

# Prevent accidental build artifacts in src
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
!packages/*/src/**/*.test.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
.cache/

# Scratch
scratch/

# Security artifacts (generated by CI)
sbom-*.json
sbom-*.xml
sbom-checksums.txt
dependency-tree.txt
audit-results.json
deps.json
sarif-results/

# CodeQL
codeql-db/
codeql-results.sarif

# Non-pnpm lock files (this repo is pnpm-only; see packageManager in package.json)
package-lock.json
yarn.lock
npm-shrinkwrap.json
bun.lockb
