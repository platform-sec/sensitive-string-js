{
  "name": "sensitive-string-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade sensitive string handling for Node.js",
  "keywords": [
    "security",
    "sensitive-data",
    "pii",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:timing": "vitest run --config vitest.timing.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint packages examples --cache",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=6144 eslint packages examples --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"examples/**/*.ts\"",
    "check:packaging": "node scripts/check-packaging.mjs",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && pnpm install --lockfile-only && pnpm release:check",
    "release:check": "node scripts/check-release-consistency.mjs",
    "release:pack": "node scripts/pack-release-plan.mjs",
    "clean": "rm -rf packages/*/dist packages/*/.turbo node_modules/.cache && find packages/*/src -name '*.js' -delete 2>/dev/null; find packages/*/src -name '*.d.ts' -delete 2>/dev/null; find packages/*/src -name '*.js.map' -delete 2>/dev/null; true",
    "codeql:download": "codeql pack download codeql/javascript-queries",
    "codeql:create": "codeql database create codeql-db --language=javascript --source-root=. --overwrite",
    "codeql:analyze": "codeql database analyze codeql-db codeql/javascript-queries:codeql-suites/javascript-code-scanning.qls --format=sarif-latest --output=codeql-results.sarif --threads=0",
    "codeql:analyze:full": "codeql database analyze codeql-db codeql/javascript-queries:codeql-suites/javascript-security-and-quality.qls --format=sarif-latest --output=codeql-results.sarif --threads=0",
    "codeql:run": "pnpm codeql:download && pnpm codeql:create && pnpm codeql:analyze",
    "codeql:run:full": "pnpm codeql:download && pnpm codeql:create && pnpm codeql:analyze:full",
    "codeql:clean": "rm -rf codeql-db codeql-results.sarif"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "^9.39.5",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "safe-regex2": "5.1.1",
    "semver": "7.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
