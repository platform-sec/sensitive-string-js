{
  "name": "@platform-sec/sensitive-string-env",
  "version": "0.1.1",
  "description": "Config and environment loader for SensitiveString - classify by variable name, wrap at the boundary, and report what removal from process.env cannot reach",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-env/",
    "test:watch": "vitest --root ../.. packages/sensitive-env/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "environment",
    "dotenv",
    "config",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/config": "^3.3.5",
    "@types/convict": "^6.1.6",
    "@types/node": "^22.20.1",
    "config": "^5.0.1",
    "convict": "^6.2.5",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
