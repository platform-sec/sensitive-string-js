{
  "name": "@platform-sec/sensitive-string-rollbar",
  "version": "0.1.0",
  "description": "Rollbar integration for SensitiveString - composes transform and checkIgnore and extends the shipped scrub lists",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-rollbar/",
    "test:watch": "vitest --root ../.. packages/sensitive-rollbar/"
  },
  "keywords": [
    "rollbar",
    "security",
    "sensitive-data",
    "redaction",
    "error-tracking",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.5.0",
    "@platform-sec/sensitive-string-scrub": "^0.1.0",
    "rollbar": "^3.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-scrub": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "rollbar": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
