{
  "name": "@platform-sec/sensitive-string-envalid",
  "version": "0.1.0",
  "description": "envalid integration for SensitiveString - sensitive validators, the construction-time refusals, and a cleanEnv whose report never prints a value",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-envalid/",
    "test:watch": "vitest --root ../.. packages/sensitive-envalid/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "envalid",
    "environment",
    "validation",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0",
    "@platform-sec/sensitive-string-env": "^0.1.0",
    "envalid": "^8.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-env": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "envalid": "^8.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
