{
  "name": "@platform-sec/sensitive-string-gcp-secrets",
  "version": "0.1.1",
  "description": "GCP Secret Manager secret source - CRC32C verification, resolved version numbers, every value wrapped as a SensitiveString",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-gcp-secrets/",
    "test:watch": "vitest --root ../.. packages/sensitive-gcp-secrets/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "gcp",
    "google-cloud",
    "secret-manager",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-secrets": "^0.2.0",
    "@google-cloud/secret-manager": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@google-cloud/secret-manager": "^7.0.0"
  }
}
