{
  "name": "@platform-sec/sensitive-string-ky",
  "version": "0.1.0",
  "description": "ky integration for SensitiveString - one reveal point at the wire, the marker guard, per-attempt audit on retries, and the error scrub ky's reject-on-non-2xx default makes a common path",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-ky/",
    "test:watch": "vitest --root ../.. packages/sensitive-ky/"
  },
  "keywords": [
    "ky",
    "http-client",
    "fetch",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0",
    "@platform-sec/sensitive-string-http": "^0.1.0",
    "ky": "^2.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-http": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "ky": "^2.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
