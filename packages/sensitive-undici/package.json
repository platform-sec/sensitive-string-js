{
  "name": "@platform-sec/sensitive-string-undici",
  "version": "0.1.0",
  "description": "undici dispatcher integration for SensitiveString - reveal, guard and audit for the one client that already fails closed, plus a dispatcher interceptor that refuses a marker",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "undici",
    "dispatcher",
    "http-client",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0",
    "@platform-sec/sensitive-string-http": "^0.1.0",
    "undici": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-http": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "undici": "^8.10.0",
    "vitest": "^4.1.11"
  }
}
