{
  "name": "@platform-sec/sensitive-string-oci-vault",
  "version": "0.1.1",
  "description": "OCI Vault secret source - the secret retrieval data plane, base64 bundle validation, every value wrapped as a SensitiveString",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-oci-vault/",
    "test:watch": "vitest --root ../.. packages/sensitive-oci-vault/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "oci",
    "oracle-cloud",
    "vault",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-oci-vault"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-secrets": "^0.2.0",
    "oci-secrets": "^2.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "oci-secrets": "^2.140.1"
  }
}
