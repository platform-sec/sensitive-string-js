{
  "name": "@platform-sec/sensitive-string-kdf",
  "version": "0.1.0",
  "description": "Password hashing for SensitiveString values - Argon2, bcrypt and scrypt behind one audited API, with the stored hash wrapped as a credential",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-kdf/",
    "test:watch": "vitest --root ../.. packages/sensitive-kdf/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "password",
    "argon2",
    "bcrypt",
    "scrypt",
    "kdf",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.5.0",
    "argon2": "^0.44.0 || ^0.45.0",
    "bcrypt": "^5.1.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "argon2": {
      "optional": true
    },
    "bcrypt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
