{
  "name": "@platform-sec/sensitive-string-http",
  "version": "0.1.0",
  "description": "Shared layer under the HTTP client integrations - the reveal walker and its scrub plan, the marker guard, the auth header descriptors, the two-path scrub, the redirect and transport checks, and the response decoder",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-http/",
    "test:watch": "vitest --root ../.. packages/sensitive-http/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "http",
    "http-client",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
