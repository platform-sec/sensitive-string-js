{
  "name": "@platform-sec/sensitive-string-newrelic",
  "version": "0.2.0",
  "description": "New Relic integration for SensitiveString - generates the exact attribute exclusions the agent's rule engine cannot lift",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-newrelic/",
    "test:watch": "vitest --root ../.. packages/sensitive-newrelic/"
  },
  "keywords": [
    "newrelic",
    "apm",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-scrub": "^0.2.0",
    "newrelic": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "newrelic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-scrub": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "newrelic": "^14.3.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
