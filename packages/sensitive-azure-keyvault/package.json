{
  "name": "@platform-sec/sensitive-string-azure-keyvault",
  "version": "0.1.0",
  "description": "Azure Key Vault secret source - expiresOn bound as a deadline, notBefore refused, every value wrapped as a SensitiveString",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-azure-keyvault/",
    "test:watch": "vitest --root ../.. packages/sensitive-azure-keyvault/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "azure",
    "key-vault",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.5.0",
    "@platform-sec/sensitive-string-secrets": "^0.1.0",
    "@azure/keyvault-secrets": "^4.8.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@azure/keyvault-secrets": "^4.11.2"
  }
}
