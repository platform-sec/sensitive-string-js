{
  "name": "@platform-sec/sensitive-string-vault",
  "version": "0.1.0",
  "description": "HashiCorp Vault and OpenBao secret source - KV v1 and v2, dynamic secret leases, response wrapping, every value wrapped as a SensitiveString",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "vault",
    "openbao",
    "hashicorp",
    "secrets-manager",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0",
    "@platform-sec/sensitive-string-secrets": "^0.1.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
