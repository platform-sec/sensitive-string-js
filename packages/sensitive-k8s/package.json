{
  "name": "@platform-sec/sensitive-string-k8s",
  "version": "0.1.1",
  "description": "Kubernetes Secret source - the API read path, the built-in type specs, the annotation strip, and the mounted volume watcher",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-k8s/",
    "test:watch": "vitest --root ../.. packages/sensitive-k8s/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "kubernetes",
    "k8s",
    "secrets",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-secrets": "^0.2.0",
    "@kubernetes/client-node": ">=0.20.0 <3"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@kubernetes/client-node": "^2.0.0"
  }
}
