{
  "name": "@platform-sec/sensitive-string-datadog",
  "version": "0.2.0",
  "description": "Datadog APM integration for SensitiveString - scrubs span tags through dd-trace plugin hooks and generates the header capture and query obfuscator configuration",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-datadog/",
    "test:watch": "vitest --root ../.. packages/sensitive-datadog/"
  },
  "keywords": [
    "datadog",
    "dd-trace",
    "apm",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-scrub": "^0.2.0",
    "dd-trace": "^6.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-scrub": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "dd-trace": "^6.14.0",
    "express": "^5.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
