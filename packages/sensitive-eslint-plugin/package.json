{
  "name": "@platform-sec/eslint-plugin-sensitive-string",
  "version": "0.2.0",
  "description": "ESLint rules that catch the mistakes SensitiveString's type system cannot: logged reveals, timing-unsafe comparisons, and unaudited transmission",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-eslint-plugin/",
    "test:watch": "vitest --root ../.. packages/sensitive-eslint-plugin/"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "security",
    "sensitive-data",
    "redaction",
    "static-analysis",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
