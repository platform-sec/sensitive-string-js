{
  "name": "@platform-sec/sensitive-string-fastify",
  "version": "0.1.0",
  "description": "Fastify integration for SensitiveString - schema keyword wrapping, body field maps, header extraction, reveal context, and response redaction",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-fastify/",
    "test:watch": "vitest --root ../.. packages/sensitive-fastify/"
  },
  "keywords": [
    "fastify",
    "plugin",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.5.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "fastify": "^5.12.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
