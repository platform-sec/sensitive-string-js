{
  "name": "@platform-sec/sensitive-string-axios",
  "version": "0.2.0",
  "description": "axios integration for SensitiveString - one reveal point at the wire, the marker guard, and the scrub that keeps a revealed credential out of the error, the response and toJSON()",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-axios/",
    "test:watch": "vitest --root ../.. packages/sensitive-axios/"
  },
  "keywords": [
    "axios",
    "http-client",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-axios"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-http": "^0.2.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-http": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "axios": "^1.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
