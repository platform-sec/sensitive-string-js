{
  "name": "@platform-sec/sensitive-string-sentry",
  "version": "0.1.1",
  "description": "Sentry integration for SensitiveString - scrubs every before* hook and the scope event processor",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-sentry/",
    "test:watch": "vitest --root ../.. packages/sensitive-sentry/"
  },
  "keywords": [
    "sentry",
    "security",
    "sensitive-data",
    "redaction",
    "error-tracking",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-sentry"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "@platform-sec/sensitive-string-scrub": "^0.2.0",
    "@sentry/node": "^10.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-scrub": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@sentry/node": "^10.73.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
