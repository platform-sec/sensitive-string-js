{
  "name": "@platform-sec/sensitive-string-zod",
  "version": "0.2.0",
  "description": "Zod integration for SensitiveString - parse input directly into sensitive types",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-zod/",
    "test:watch": "vitest --root ../.. packages/sensitive-zod/"
  },
  "keywords": [
    "zod",
    "validation",
    "security",
    "sensitive-data",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
