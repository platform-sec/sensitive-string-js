{
  "name": "@platform-sec/sensitive-string-aws-secrets",
  "version": "0.1.0",
  "description": "AWS Secrets Manager secret source - staging labels, resolved version ids, every value wrapped as a SensitiveString",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-aws-secrets/",
    "test:watch": "vitest --root ../.. packages/sensitive-aws-secrets/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "aws",
    "secrets-manager",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.5.0",
    "@platform-sec/sensitive-string-secrets": "^0.1.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-secrets": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@aws-sdk/client-secrets-manager": "^3.937.0"
  }
}
