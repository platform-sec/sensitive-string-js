{
  "name": "@platform-sec/sensitive-string-core",
  "version": "0.6.0",
  "description": "Core library for handling sensitive string data with automatic redaction",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-core/",
    "test:watch": "vitest --root ../.. packages/sensitive-core/"
  },
  "keywords": [
    "security",
    "sensitive-data",
    "pii",
    "redaction",
    "typescript",
    "privacy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-core"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "bson": "^7.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "winston": "^3.19.0"
  }
}
