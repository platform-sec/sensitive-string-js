{
  "name": "@platform-sec/sensitive-string-decorators",
  "version": "0.1.1",
  "description": "Framework-agnostic Stage 3 decorators for SensitiveString - declarative field wrapping and reveal context",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-decorators/",
    "test:watch": "vitest --root ../.. packages/sensitive-decorators/"
  },
  "keywords": [
    "decorators",
    "stage-3",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-decorators"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
