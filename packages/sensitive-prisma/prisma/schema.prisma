// Test schema for the sensitive-prisma integration suite. It is not published:
// `files` in package.json ships `dist` only, and the client it generates is
// gitignored and regenerated by `pnpm build` and `pnpm test`.
//
// `moduleFormat` is cjs because every package here compiles to CommonJS: the
// sources are NodeNext ESM but no manifest sets "type": "module", so an ESM
// client would be loaded as CommonJS and fail on `import.meta.url`.
//
// SQLite is the provider because the suite runs against an in-memory database
// with no service to start. It has no scalar list type, so the `list: true`
// branch of the result component is covered by unit tests over the real
// builder rather than end to end; the README says so.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  passwordHash String
  name         String
  // Nullable, so the `null` passthrough and the `nullable: true` type widening
  // are exercised against a real column rather than a fixture.
  nickname     String?
  posts        Post[]
  cards        PaymentMethod[]
}

model Post {
  id       Int    @id @default(autoincrement())
  title    String
  secret   String
  authorId Int
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id         Int      @id @default(autoincrement())
  cardNumber String
  cardCvv    String
  cardExpiry String
  // Three column types the argument walk must hand to the driver untouched.
  balance    Decimal
  token      Bytes
  createdAt  DateTime @default(now())
  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
