{
  "name": "@platform-sec/sensitive-string-got",
  "version": "0.1.0",
  "description": "got integration for SensitiveString - one reveal point at the wire, the marker guard, per-attempt audit on retries, and the scrub that keeps a revealed credential out of options on both settlement paths",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "got",
    "http-client",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.1.0",
    "@platform-sec/sensitive-string-http": "^0.1.0",
    "got": "^14.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-http": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/node": "^22.20.1",
    "got": "^16.0.0",
    "got14": "npm:got@^14.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
