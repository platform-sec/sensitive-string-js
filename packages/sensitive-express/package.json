{
  "name": "@platform-sec/sensitive-string-express",
  "version": "0.1.1",
  "description": "Express integration for SensitiveString - body wrapping, header extraction, reveal context, and response redaction",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/sensitive-express/",
    "test:watch": "vitest --root ../.. packages/sensitive-express/"
  },
  "keywords": [
    "express",
    "middleware",
    "security",
    "sensitive-data",
    "redaction",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-sec/sensitive-string-js.git",
    "directory": "packages/sensitive-express"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@platform-sec/sensitive-string-core": "^0.6.0",
    "express": "^4.21.0 || ^5.0.0"
  },
  "devDependencies": {
    "@platform-sec/sensitive-string-core": "workspace:*",
    "@platform-sec/sensitive-string-testing": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "express4": "npm:express@^4.21.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
