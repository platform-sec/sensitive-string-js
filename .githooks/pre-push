#!/usr/bin/env bash
# Run `pnpm verify` before a push, so a red CI is found here rather than on main.
#
# Installed by `pnpm install` (the root `prepare` script sets core.hooksPath to
# this directory). Skip it for one push with `git push --no-verify`.
#
# The checks run against the working tree, so the hook refuses to vouch for
# anything the working tree is not: uncommitted changes, or a pushed commit
# other than HEAD.
set -euo pipefail

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  # A deletion pushes nothing to check.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  # A tag points at a commit that was checked when it was pushed.
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_ref is not HEAD, and the checks run on the working tree." >&2
    echo "pre-push: check out what you are pushing, or push with --no-verify." >&2
    exit 1
  fi
  pushing=1
done

if [ "$pushing" -eq 0 ]; then
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: the working tree has changes that are not in the pushed commit," >&2
  echo "pre-push: so a pass would describe something else. Commit or stash them first." >&2
  git status --short >&2
  exit 1
fi

exec pnpm verify
