{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts"],
  // sensitive-nestjs compiles under `experimentalDecorators`, which the base
  // config does not enable and which cannot be turned on for part of a
  // program: a file is compiled under the legacy decorator model or the Stage
  // 3 one, never both. It is checked through its own tsconfig instead.
  "exclude": ["packages/sensitive-nestjs"]
}
