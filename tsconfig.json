{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts"],
  // sensitive-nestjs compiles under `experimentalDecorators`, which the base
  // config does not enable and which cannot be turned on for part of a
  // program: a file is compiled under the legacy decorator model or the Stage
  // 3 one, never both. It is checked through its own tsconfig instead.
  //
  // sensitive-prisma/generated is the Prisma client its test schema generates.
  // It is regenerated by `pnpm build`, gitignored, and carries `@ts-nocheck`,
  // so checking it costs parse time and reports nothing. The test files that
  // import it are still checked, which is where the seam actually matters.
  "exclude": ["packages/sensitive-nestjs", "packages/sensitive-prisma/generated"]
}
